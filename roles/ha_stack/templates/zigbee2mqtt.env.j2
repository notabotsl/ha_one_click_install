# {{ ansible_managed }}
TZ={{ ha_tz }}
ZIGBEE2MQTT_CONFIG_MQTT_SERVER={{ ha_mqtt_server }}
ZIGBEE2MQTT_CONFIG_MQTT_USER={{ ha_mqtt_user }}
ZIGBEE2MQTT_CONFIG_MQTT_PASSWORD={{ ha_secrets.mqtt_password }}
ZIGBEE2MQTT_CONFIG_SERIAL_PORT=/dev/zigbee
{% if ha_zigbee_adapter | length > 0 %}
ZIGBEE2MQTT_CONFIG_SERIAL_ADAPTER={{ ha_zigbee_adapter }}
{% endif %}
ZIGBEE2MQTT_CONFIG_HOMEASSISTANT_ENABLED=true
ZIGBEE2MQTT_CONFIG_FRONTEND_ENABLED=true
ZIGBEE2MQTT_CONFIG_FRONTEND_PORT=8080
ZIGBEE2MQTT_CONFIG_FRONTEND_AUTH_TOKEN={{ ha_secrets.zigbee2mqtt_token }}
